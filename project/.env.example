# API Keys (Choose one or provide both)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: "openai" | "gemini" | "mock" (for deterministic local testing)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Application Configuration
DEFAULT_TENANT=aster-and-row
DEBUG_MODE=true
HOST=0.0.0.0
PORT=8000
